# Dependencies
node_modules/

# Build artifacts
dist/
.astro/
.cache/
*.tsbuildinfo

# Worker local scratch artifacts. sqlite:build writes its output under
# apps/worker/.build/ (backend-neutral name). apps/worker/.wrangler/ is the
# historical output dir name (Cloudflare removed 2026-06-13); kept so existing
# local scratch state (e.g. cached crawl audits) stays ignored.
# apps/web/.wrangler/ is Cloudflare Pages' local dev/build state and is still
# live — see apps/web/wrangler.toml.
apps/worker/.build/
apps/worker/.wrangler/
apps/web/.wrangler/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.*
!.env.example

# OMC session state — never commit.
.omc/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
.claude/

# Local-only project docs (kept on disk for the active Claude Code session;
# the repo is intentionally agent-tooling-agnostic).
CLAUDE.md

# Playwright MCP tooling artifact
.playwright-mcp/

# CodeGraph generated local index
.codegraph/

# Playwright MCP screenshots from local verification runs
apps/web/.playwright-mcp/
apps/web/test-results/
phase4-*.png
.superpowers/
.tmp_review/
scripts/data/medium-chunk-*.json
scripts/data/medium-retry-*.json
scripts/data/medium-review*.csv

# R1 missing-JOYSOUND audit default output dir (generated CSV/summary, never committed)
scripts/data/audit-missing-joysound/

# R4-4 JOYSOUND artistId index (generated from the NAS detail-sweep logs, never committed)
scripts/data/joysound-artist-id-index.json
