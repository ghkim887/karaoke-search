{
  "name": "@karaoke/crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "karaoke-crawl": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/export-drop-list.mjs && node ../../scripts/export-chinese-drop-list.mjs && node ../../scripts/export-post-category-overrides.mjs && node ../../scripts/export-clustering-rules.mjs",
    "prestart": "tsc -b",
    "start": "node ./dist/cli.js",
    "test": "tsc -b && vitest run && vitest run --root=../.. scripts/apply-manual-title-ko-fixes.test.mjs scripts/manual-fix-title-ko.test.mjs scripts/translate_title_ko_via_agents.test.mjs scripts/lib-atomic-write.test.mjs scripts/corpus-audit-guardrails.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@karaoke/category-rules": "workspace:*",
    "@karaoke/schema": "workspace:*",
    "cheerio": "^1.0.0",
    "robots-parser": "^3.0.1",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
