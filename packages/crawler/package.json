{
  "name": "@karaoke/crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "karaoke-crawl": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/export-drop-list.mjs && node ../../scripts/export-clustering-rules.mjs",
    "prestart": "tsc -b",
    "start": "node ./dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@karaoke/schema": "workspace:*",
    "@karaoke/search": "workspace:*",
    "cheerio": "^1.0.0",
    "robots-parser": "^3.0.1",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
