{
  "name": "@karaoke/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run test/search.test.ts && corepack pnpm run test:d1-runtime",
    "typecheck": "tsc --noEmit",
    "test:d1-runtime": "corepack pnpm --filter @karaoke/data-store build && tsc -b && vitest run test/d1-runtime.test.ts"
  },
  "dependencies": {
    "@karaoke/schema": "workspace:*"
  },
  "devDependencies": {
    "@karaoke/data-store": "workspace:*",
    "@types/node": "^24.12.4",
    "miniflare": "^4.20260526.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
