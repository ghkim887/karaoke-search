{
  "name": "@karaoke/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "sqlite:build": "tsc -b && node scripts/build-sqlite-db.mjs",
    "serve:node": "node dist/node-server.js"
  },
  "dependencies": {
    "@karaoke/data-store": "workspace:*",
    "@karaoke/schema": "workspace:*",
    "@karaoke/search": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
