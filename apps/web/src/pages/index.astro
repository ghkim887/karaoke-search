---
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { App } from '../components/App';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
// Page-global styles hoisted verbatim from this page's former global style
// block. Import order matters: must come AFTER tokens.css to preserve the
// final cascade order in the built CSS.
import '../styles/global.css';
// Read the corpus at build time so the loading-state label tracks the live
// record count automatically. Build-time only — the JSON is not bundled into
// the client.
const songsPath = fileURLToPath(new URL('../../public/data/songs.json', import.meta.url));
const songCount = (JSON.parse(readFileSync(songsPath, 'utf8')) as unknown[]).length;
const title = '일본 노래 검색기';
const fontsHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/fonts/fonts.css`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="stylesheet" href={fontsHref} />
  </head>
  <body>
    <header class="site-header">
      <h1 class="site-title">{title}</h1>
      <p class="site-subtitle">Karaoke Search</p>
    </header>
    <App client:load songCount={songCount} />
    <Footer />
  </body>
</html>
