---
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { maxCrawledDate } from '../lib/footer-date.js';
import { t } from '../lib/i18n.js';

// Build-time initial/fallback date: the most recent `crawled_at` in the bundled
// corpus, mirroring how index.astro reads songs.json for the record count.
// Build-time only — the JSON is not bundled into the client. This is only the
// initial render; the inline script below replaces it at runtime with the live
// value from GET /api/meta (the serving DB updates independently of the static
// deploy). On any fetch failure the build-time date stays.
const songsPath = fileURLToPath(new URL('../../public/data/songs.json', import.meta.url));
const records = JSON.parse(readFileSync(songsPath, 'utf8')) as { crawled_at?: string }[];
const dbDate = maxCrawledDate(records.map((record) => record.crawled_at));
---

<footer class="site-footer">
  <div class="site-footer-brand" lang="en">KARAOKE SEARCH</div>
  {/* All three disclaimer translations are rendered; `applyChrome()` toggles
      their visibility by locale. The Korean default preserves today's two-line
      bilingual form (ko + en shown); en/ja collapse to their single line. Text
      comes from the i18n catalog (single source of truth). */}
  <p class="site-footer-disclaimer">
    <span class="site-footer-disclaimer-ko" data-disclaimer="ko">{t('ko', 'disclaimer')}</span>
    <span class="site-footer-disclaimer-en" lang="en" data-disclaimer="en">{t('en', 'disclaimer')}</span>
    <span class="site-footer-disclaimer-ja" lang="ja" data-disclaimer="ja" hidden>{t('ja', 'disclaimer')}</span>
  </p>
  <div class="site-footer-meta">
    <span class="site-footer-meta-item" data-db-updated hidden={dbDate === ''}
      ><span data-i18n="dbUpdatedLabel">{t('ko', 'dbUpdatedLabel')}</span> <span
        data-db-updated-date>{dbDate}</span
      ></span
    >
    <span class="site-footer-meta-sep" aria-hidden="true" data-db-updated-sep hidden={dbDate === ''}
      >·</span
    >
    <a
      class="site-footer-meta-item site-footer-link"
      href="https://github.com/ghkim887/karaoke-search/blob/main/LICENSE"
      target="_blank"
      rel="noreferrer noopener"
    >
      MIT
    </a>
    <span class="site-footer-meta-sep" aria-hidden="true">·</span>
    <a
      class="site-footer-meta-item site-footer-link"
      href="https://github.com/ghkim887/karaoke-search/issues"
      target="_blank"
      rel="noreferrer noopener"
      data-i18n="reportIssue"
    >{t('ko', 'reportIssue')}</a>
    <span class="site-footer-meta-sep" aria-hidden="true">·</span>
    <a
      class="site-footer-meta-item site-footer-link"
      href="https://github.com/ghkim887/karaoke-search"
      target="_blank"
      rel="noreferrer noopener"
    >
      GitHub ↗
    </a>
  </div>
</footer>

<script>
  import { getApiSearchBaseUrl } from '../lib/search.js';

  // Replace the build-time DB-update date with the live value from the serving
  // database (GET /api/meta), which is updated independently of this static
  // deploy. On any failure (no API configured, offline, an older API without
  // /api/meta, or a malformed/empty payload) the build-time date is left
  // untouched, so the footer degrades to exactly the server-rendered value.
  const base = getApiSearchBaseUrl();
  const item = document.querySelector<HTMLElement>('[data-db-updated]');
  const dateEl = document.querySelector<HTMLElement>('[data-db-updated-date]');
  const sep = document.querySelector<HTMLElement>('[data-db-updated-sep]');
  if (base !== null && item !== null && dateEl !== null && sep !== null) {
    void (async () => {
      try {
        const response = await fetch(new URL('api/meta', `${base}/`).toString(), {
          headers: { accept: 'application/json' },
        });
        if (!response.ok) return;
        const data = (await response.json()) as { dbUpdatedAt?: unknown };
        const value = typeof data.dbUpdatedAt === 'string' ? data.dbUpdatedAt : '';
        if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return;
        dateEl.textContent = value;
        // Reveal the token if the build-time corpus had no date but the live DB
        // does; a no-op when it was already shown.
        item.hidden = false;
        sep.hidden = false;
      } catch {
        // Network/parse failure — keep the build-time date.
      }
    })();
  }
</script>
