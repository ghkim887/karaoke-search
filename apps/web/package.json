    "minisearch": "^7.1.1",
    "preact": "^10.25.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.11.2",
    "@karaoke/data-store": "workspace:*",
    "@karaoke/worker": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.4",
    "@vite-pwa/astro": "^1.2.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^2.1.8",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
