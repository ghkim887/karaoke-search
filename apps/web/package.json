{
  "name": "@karaoke/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/check-bundle-size.mjs",
    "build:icons": "node scripts/build-pwa-icons.mjs",
